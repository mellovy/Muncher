{
  "name": "muncher",
  "version": "1.1.0",
  "description": "MUNCHER - custom game launcher",
  "main": "main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/mellovy/muncher.git"
  },
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^37.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.mello.muncher",
    "productName": "Muncher",
    "asar": true,
    "compression": "maximum",
    "files": [
      "main.js",
      "preload.js",
      "launcher.html",
      "overlay.html",
      "style.css",
      "muncher.ico"
    ],
    "asarUnpack": [
      "**/node_modules/ffmpeg-static/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "muncher.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "mellovy",
        "repo": "muncher"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "ffmpeg-static": "^5.2.0"
  },
  "allowScripts": {
    "electron@37.10.3": true,
    "electron-winstaller@5.4.0": true,
    "ffmpeg-static": true
  }
}