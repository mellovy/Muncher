{
  "name": "muncher",
  "version": "1.0.1",
  "description": "MUNCHER - custom game launcher",
  "main": "main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/mellovy/muncher.git"
  },
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^37.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.mello.muncher",
    "productName": "Muncher",
    "asar": true,
"compression": "maximum",
    "files": [
      "main.js",
      "downloads.js",
      "scraper.js",
      "preload.js",
      "launcher.html",
      "style.css",
      "muncher.ico"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/muncher.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "mellovy",
        "repo": "muncher"
      }
    ]
  },
  "dependencies": {
    "axios": "^1.7.0",
    "cheerio": "^1.0.0-rc.14",
    "electron-updater": "^6.8.9",
    "extract-zip": "^2.0.1",
    "webtorrent": "^2.5.15"
  },
  "allowScripts": {
    "electron@37.10.3": true,
    "electron-winstaller@5.4.0": true,
    "utp-native@2.5.3": true,
    "bufferutil@4.1.0": true,
    "utf-8-validate@6.0.6": true,
    "node-datachannel@0.32.3": true,
    "ip-set@3.0.0": true
  }
}
